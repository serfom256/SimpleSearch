<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-search-config-table-v1" author="com.simplesearch" >
        <createTable tableName="search_config">
            <column name="name" type="VARCHAR(100)">
                <constraints primaryKey="true"/>
            </column>
            <column name="property" type="VARCHAR(100)"/>
        </createTable>
    </changeSet>

    <changeSet id="populate-search-config-v1" author="com.simplesearch">
        <insert tableName="search_config">
            <column name="name" value="simplesearch.shards.used"/>
            <column name="property" value="1"/>
        </insert>
        <modifySql dbms="postgresql">
            <append value=" ON CONFLICT (name) DO NOTHING"/>
        </modifySql>
    </changeSet>

</databaseChangeLog>